#include <winuser.h>
#include "resources.h"
#pragma code_page(65001)
1 RT_MANIFEST "app.manifest"
IDI_APP ICON "app.ico"

IDD_SELECT_SWF DIALOGEX 0, 0, 294, 178
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_DIALOG_PROMPT, 10, 9, 274, 11
    LISTBOX IDC_SWF_ENTRIES, 10, 25, 274, 117, LBS_NOTIFY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "", IDOK, 167, 152, 55, 16
    PUSHBUTTON "", IDCANCEL, 229, 152, 55, 16
END

IDD_CONFIRM_CLOSE DIALOGEX 0, 0, 236, 67
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_DIALOG_PROMPT, 12, 11, 212, 22
    PUSHBUTTON "", IDOK, 104, 42, 55, 16
    DEFPUSHBUTTON "", IDCANCEL, 169, 42, 55, 16
END

IDD_LOCALIZED_MESSAGE DIALOGEX 0, 0, 286, 76
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_DIALOG_ICON, "Static", SS_ICON, 12, 12, 24, 24
    LTEXT "", IDC_DIALOG_PROMPT, 43, 12, 230, 37
    PUSHBUTTON "", IDOK, 154, 51, 55, 16
    DEFPUSHBUTTON "", IDCANCEL, 219, 51, 55, 16
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "FlashFasaFiso"
            VALUE "ProductName", "FlashFasaFiso"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "FlashFasaFiso.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
